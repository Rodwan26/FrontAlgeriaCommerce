"use client";

import Link from "next/link";
import {
  LayoutDashboard,
  Package,
  ShoppingCart,
  Settings,
  Store,
  X,
  PanelLeftClose,
  PanelLeftOpen,
} from "lucide-react";

type SidebarProps = {
  isOpen: boolean;
  isCollapsed: boolean;
  onClose: () => void;
  onToggleCollapse: () => void;
};

const links = [
  {
    title: "Dashboard",
    href: "/admin",
    icon: LayoutDashboard,
  },
  {
    title: "Products",
    href: "/admin/products",
    icon: Package,
  },
  {
    title: "Orders",
    href: "/admin/orders",
    icon: ShoppingCart,
  },
  {
    title: "Categories",
    href: "/admin/categories",
    icon: Package,
  },
  {
    title: "Settings",
    href: "/admin/settings",
    icon: Settings,
  },
];

export default function Sidebar({
  isOpen,
  isCollapsed,
  onClose,
  onToggleCollapse,
}: SidebarProps) {
  return (
    <>
      {/* Mobile overlay */}
      {isOpen && (
        <div
          className="fixed inset-0 z-40 bg-black/40 lg:hidden"
          onClick={onClose}
        />
      )}

      {/* Sidebar */}
      <aside
        className={`
          fixed inset-y-0 left-0 z-50
          flex flex-col
          border-r border-gray-200 bg-white
          transition-all duration-300 ease-in-out
          lg:static lg:z-auto lg:translate-x-0
          ${isCollapsed ? "lg:w-16" : "lg:w-52"}
          ${isOpen ? "translate-x-0" : "-translate-x-full"}
          lg:shrink-0
        `}
      >
        {/* Logo */}
        <div
          className={`
            flex h-16 shrink-0 items-center border-b border-gray-200
            ${isCollapsed ? "justify-center px-2" : "justify-between px-5"}
          `}
        >
          <div
            className={`
              flex min-w-0 items-center
              ${isCollapsed ? "justify-center" : "gap-3"}
            `}
          >
            <Store className="h-6 w-6 shrink-0 text-indigo-600" />

            {!isCollapsed && (
              <span className="truncate text-xl font-bold text-gray-900">
                My Store
              </span>
            )}
          </div>

          {/* Mobile close */}
          <button
            type="button"
            onClick={onClose}
            className="rounded-lg p-2 text-gray-500 transition hover:bg-gray-100 lg:hidden"
            aria-label="Close menu"
          >
            <X size={20} />
          </button>
        </div>

        {/* Navigation */}
        <nav
          className={`
            flex-1 overflow-y-auto
            ${isCollapsed ? "space-y-2 p-2" : "space-y-2 p-4"}
          `}
        >
          {links.map((link) => {
            const Icon = link.icon;

            return (
              <Link
                key={link.href}
                href={link.href}
                onClick={onClose}
                title={isCollapsed ? link.title : undefined}
                className={`
                  flex items-center rounded-xl
                  text-gray-700
                  transition
                  hover:bg-gray-100 hover:text-indigo-600
                  ${isCollapsed
                    ? "justify-center px-2 py-3"
                    : "gap-3 px-4 py-3"}
                `}
              >
                <Icon size={20} className="shrink-0" />

                {!isCollapsed && (
                  <span className="font-medium">
                    {link.title}
                  </span>
                )}
              </Link>
            );
          })}
        </nav>

        {/* Collapse button - desktop */}
        <div className="hidden shrink-0 border-t border-gray-200 p-2 lg:block">
          <button
            type="button"
            onClick={onToggleCollapse}
            title={isCollapsed ? "Expand sidebar" : "Collapse sidebar"}
            className={`
              flex w-full items-center rounded-xl
              text-gray-600 transition
              hover:bg-gray-100 hover:text-indigo-600
              ${isCollapsed
                ? "justify-center px-2 py-3"
                : "gap-3 px-4 py-3"}
            `}
          >
            {isCollapsed ? (
              <PanelLeftOpen size={20} />
            ) : (
              <>
                <PanelLeftClose size={20} />
                <span className="font-medium">
                  Collapse
                </span>
              </>
            )}
          </button>
        </div>
      </aside>
    </>
  );
}
