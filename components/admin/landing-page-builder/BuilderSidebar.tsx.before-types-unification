"use client";

import {
  ArrowDown,
  ArrowUp,
  Eye,
  EyeOff,
  Layers,
  Monitor,
  Palette,
  Plus,
  Smartphone,
  Trash2,
} from "lucide-react";

import { LandingSection, LandingSectionType } from "../../../lib/landing-page/types";

type BuilderSidebarProps = {
  sections: LandingSection[];
  selectedId: string | null;
  onSelect: (id: string) => void;
  onAdd: (type: LandingSectionType) => void;
  onToggle: (id: string) => void;
  onMove: (id: string, direction: "up" | "down") => void;
  onRemove: (id: string) => void;
};

const sectionLabels: Record<LandingSectionType, string> = {
  hero: "Hero",
  product: "Product",
  image: "Image",
  features: "Features",
  testimonials: "Testimonials",
  faq: "FAQ",
  "order-form": "Order form",
};

export default function BuilderSidebar({
  sections,
  selectedId,
  onSelect,
  onAdd,
  onToggle,
  onMove,
  onRemove,
}: BuilderSidebarProps) {
  return (
    <aside className="flex h-full w-[300px] shrink-0 flex-col border-r border-gray-200 bg-white">
      <div className="border-b border-gray-200 p-5">
        <div className="flex items-center gap-2">
          <Layers size={18} className="text-indigo-600" />
          <h2 className="font-semibold text-gray-900">Sections</h2>
        </div>

        <p className="mt-1 text-xs text-gray-500">
          Build your landing page section by section.
        </p>
      </div>

      <div className="flex-1 overflow-y-auto p-4">
        <div className="space-y-2">
          {sections.map((section, index) => {
            const selected = selectedId === section.id;

            return (
              <div
                key={section.id}
                className={`rounded-lg border p-2 transition ${
                  selected
                    ? "border-indigo-300 bg-indigo-50"
                    : "border-gray-200 bg-white"
                }`}
              >
                <button
                  type="button"
                  onClick={() => onSelect(section.id)}
                  className="flex w-full items-center justify-between gap-2 px-2 py-1.5 text-left"
                >
                  <span className="text-sm font-medium text-gray-800">
                    {index + 1}. {sectionLabels[section.type]}
                  </span>

                  {!section.enabled && (
                    <EyeOff size={15} className="text-gray-400" />
                  )}
                </button>

                {selected && (
                  <div className="mt-2 flex items-center gap-1 border-t border-indigo-100 pt-2">
                    <button
                      type="button"
                      onClick={() => onToggle(section.id)}
                      className="rounded-md p-1.5 text-gray-500 hover:bg-white"
                      title="Show / hide"
                    >
                      {section.enabled ? (
                        <Eye size={15} />
                      ) : (
                        <EyeOff size={15} />
                      )}
                    </button>

                    <button
                      type="button"
                      disabled={index === 0}
                      onClick={() => onMove(section.id, "up")}
                      className="rounded-md p-1.5 text-gray-500 hover:bg-white disabled:opacity-30"
                      title="Move up"
                    >
                      <ArrowUp size={15} />
                    </button>

                    <button
                      type="button"
                      disabled={index === sections.length - 1}
                      onClick={() => onMove(section.id, "down")}
                      className="rounded-md p-1.5 text-gray-500 hover:bg-white disabled:opacity-30"
                      title="Move down"
                    >
                      <ArrowDown size={15} />
                    </button>

                    <button
                      type="button"
                      onClick={() => onRemove(section.id)}
                      className="ml-auto rounded-md p-1.5 text-gray-400 hover:bg-red-50 hover:text-red-600"
                      title="Remove"
                    >
                      <Trash2 size={15} />
                    </button>
                  </div>
                )}
              </div>
            );
          })}
        </div>

        <div className="mt-6">
          <p className="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">
            Add section
          </p>

          <div className="grid grid-cols-2 gap-2">
            {(Object.keys(sectionLabels) as LandingSectionType[]).map(
              (type) => (
                <button
                  key={type}
                  type="button"
                  onClick={() => onAdd(type)}
                  className="flex items-center gap-2 rounded-lg border border-gray-200 px-3 py-2.5 text-left text-xs font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50"
                >
                  <Plus size={14} className="text-indigo-600" />
                  {sectionLabels[type]}
                </button>
              )
            )}
          </div>
        </div>
      </div>
    </aside>
  );
}
